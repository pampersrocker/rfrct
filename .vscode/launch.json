    "version": "0.2.0",
    "configurations": [
    {
        "name": "Flask Development",
        "type": "debugpy",
        "request": "launch",
        "module": "flask",
        "cwd": "${workspaceFolder}/rfrct/",
        "env": {
            "FLASK_APP": "wsgi.py",
            "FLASK_DEBUG": "1",
            "FLASK_CONFIG_DEFAULT": "Dev",
            "FLASK_ENV": "development"
        },
        "envFile": ".env",
        "args": [
            "run"
        ],
        "jinja": true,
        "autoStartBrowser": false,
        "justMyCode": false
    },

    ]
}